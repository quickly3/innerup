# ─────────────────────────────────────────────
# 数据库 —— 远端托管 PostgreSQL（Neon / Supabase / Railway）
# 本地无需安装数据库、无需 Docker。
# ─────────────────────────────────────────────
# 填好连接串后重启后端即可；留空时 /api/health 会返回 database: "down"
#
# Neon 示例：
#   带 `-pooler` 的是连接池地址（应用运行时用）
#   去掉 `-pooler` 的是直连地址（迁移 / CLI 用，建议填进 DATABASE_URL）
#   远端库必须带 `sslmode=require`
#
# DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/innerup?sslmode=require"
DATABASE_URL=""

# 可选：迁移用 shadow database（账号无建库权限时 Prisma 会报 P3014，此时才需要）
# SHADOW_DATABASE_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/innerup_shadow?sslmode=require"

# ─────────────────────────────────────────────
# 服务
# ─────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ─────────────────────────────────────────────
# AI（M4 起才会用到，先留空）
# 仅后端读取，绝不转发给前端
# ─────────────────────────────────────────────
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ─────────────────────────────────────────────
# GitHub（可选，M2.5 的「GitHub 地址录入」用）
# 留空也能用：未认证额度 60 次/小时 → 最多读 6 个仓库
# 填了 → 额度 5000 次/小时、最多读 12 个仓库
# 去哪拿（只读公开数据，不需要任何写权限）：
#   - 经典 token：https://github.com/settings/tokens → Generate new token (classic)
#     → scopes 一个都不勾 → 复制 ghp_…（最省事）
#   - 细粒度 token：https://github.com/settings/personal-access-tokens/new
#     → Repository access 选 Public Repositories (read-only) → 复制 github_pat_…
# 只读公开内容：账号资料卡（overview）+ 公开仓库 README
# 仅后端读取，绝不转发给前端；本文件已被 .gitignore，绝不提交
# 验证：curl -s -H "Authorization: Bearer <token>" https://api.github.com/rate_limit
# ─────────────────────────────────────────────
GITHUB_TOKEN=
