# ─────────────────────────────────────────────
# 数据库 —— 远端托管 PostgreSQL（Neon / Supabase / Railway）
# 本地无需安装数据库、无需 Docker。
# ─────────────────────────────────────────────
# 填好连接串后重启后端即可；留空时 /api/health 会返回 database: "down"
#
# Neon 示例：
#   带 `-pooler` 的是连接池地址（应用运行时用）
#   去掉 `-pooler` 的是直连地址（迁移 / CLI 用，建议填进 DATABASE_URL）
#   远端库必须带 `sslmode=require`
#
# DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/innerup?sslmode=require"
DATABASE_URL=""

# 可选：迁移用 shadow database（账号无建库权限时 Prisma 会报 P3014，此时才需要）
# SHADOW_DATABASE_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/innerup_shadow?sslmode=require"

# ─────────────────────────────────────────────
# 服务
# ─────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ─────────────────────────────────────────────
# AI（M4 起才会用到，先留空）
# 仅后端读取，绝不转发给前端
# ─────────────────────────────────────────────
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
