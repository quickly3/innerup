// InnerUp 数据模型
// 对应《项目规划》第 7 节。数据库：远端托管 PostgreSQL。
// 连接串配置见根目录 `prisma.config.ts`（Prisma v7 起不写在 schema 里）。

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 用户（MVP 阶段为免登录单用户，仅存一条记录）
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  level     Int      @default(1)
  xp        Int      @default(0)
  createdAt DateTime @default(now())

  skills       Skill[]
  goals        Goal[]
  checkIns     CheckIn[]
  achievements Achievement[]
}

// 能力 / 兴趣，用于技能雷达图
model Skill {
  id     String  @id @default(cuid())
  userId String
  name   String // 编程 / 写作 / 体能 ...
  level  Int     @default(1)
  xp     Int     @default(0)
  color  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 任务线（目标）
model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String // 学会弹吉他
  description String?
  status      String   @default("active") // active | paused | done
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests Quest[]

  @@index([userId])
}

// 单个任务
model Quest {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  description String?
  difficulty  Int       @default(1) // 1~5
  xpReward    Int       @default(10)
  estMinutes  Int?
  order       Int       @default(0)
  status      String    @default("todo") // todo | doing | done
  dueDate     DateTime?

  goal     Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([goalId])
}

// 打卡记录
model CheckIn {
  id          String   @id @default(cuid())
  questId     String
  userId      String
  content     String? // 文字总结
  evidenceUrl String? // 图片 / 链接
  minutes     Int?
  xpEarned    Int      @default(0)
  createdAt   DateTime @default(now())

  quest  Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review?

  @@index([questId])
  @@index([userId, createdAt])
}

// AI 评审
model Review {
  id        String   @id @default(cuid())
  checkInId String   @unique
  score     Int // 0~100
  feedback  String // AI 反馈正文
  nextHint  String? // 下一步建议
  createdAt DateTime @default(now())

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
}

// 成就 / 徽章
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  code       String // streak_7 / first_quest ...
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}
